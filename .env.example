# TiroTime Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# Database Connection (Docker: host.docker.internal = SQL Server auf dem Host)
ConnectionStrings__DefaultConnection=Server=host.docker.internal;Database=TiroTime;User Id=usrTiroTime;Password=YourStrong!Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT Secret (minimum 32 characters) -> Jwt__Secret
JWT_SECRET=your_secure_jwt_secret_key_here_minimum_32_characters

# Mailjet Email Service -> Mailjet__ApiKey / Mailjet__ApiSecret / Mailjet__FromEmail
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_API_SECRET=your_mailjet_api_secret_here
MAILJET_FROM_EMAIL=your-email@example.com

# API-Keys (Header X-Api-Key)
# Pflicht für GET /api/reports/summary und /api/reports/timesheet
ReportsApi__ApiKey=your_reports_api_key_here
# Optional für POST /api/time-entries (ohne Wert ist der Endpunkt offen)
# TimeLoggingApi__ApiKey=your_time_logging_api_key_here

# Standard User Seed (optional, derzeit im Seeder deaktiviert)
# SeedUsers__StandardUser__Email=user@example.com
# SeedUsers__StandardUser__FirstName=John
# SeedUsers__StandardUser__LastName=Doe
# SeedUsers__StandardUser__Password=SecurePassword123!
